# --- AI (required for real scans; without it the app runs in demo mode) ---
# Free key: https://openrouter.ai/keys  (free models need no credit)
OPENROUTER_API_KEY=
# Optional: force specific models, comma-separated, tried in order.
# Leave empty to auto-pick OpenRouter's free image-capable models.
OPENROUTER_MODEL=

# --- Database (optional locally; required on Render so history survives restarts) ---
# Supabase > Project Settings > API: Project URL and the service_role key (server-side only!)
SUPABASE_URL=
SUPABASE_KEY=

# Public URL of your deployment (sent to OpenRouter as the app referer)
APP_URL=http://localhost:5000
